@page "/p/{GameId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@inject GameStateManager GameStateManager
@inject ProtectedLocalStorage ProtectedLocalStore
@inject NavigationManager NavigationManager

@if (GameState is not null && LocalPlayer is not null)
{
    @if (!LocalPlayer.IsHost)
    {
        <div class="player-view">
            <div class="title-bar">
                <span class="game-id">Game @GameId</span>
                <span class="player-id">Player @LocalPlayer.Id</span>
            </div>
            <div class="cards player-cards">
                <span class="card"><img class="card-img" src="images/cards/@(GameState.GetCardsForPlayer(LocalPlayer)[0]).svg" /></span>
                <span class="card"><img class="card-img" src="images/cards/@(GameState.GetCardsForPlayer(LocalPlayer)[1]).svg" /></span>
            </div>
        </div>
    }
    else
    {
        <div class="host-view">
            <div class="title-bar">
                <span class="game-id">Game @GameId</span>
                <span class="player-count">Players: @GameState.PlayerCount</span>
            </div>

            <div class="cards community-cards">
                @if (ShowQrCode)
                {
                    <div class="join-qr">
                        <img class="qr-code" src="@JoinQrCodeDataUri" alt="Scan to join the game" />
                        <p class="join-hint">Scan to join</p>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < 5; i++)
                    {
                        var dealt = (i < 3 && GameState.HandState >= HandState.Flop)
                            || (i == 3 && GameState.HandState >= HandState.Turn)
                            || (i == 4 && GameState.HandState >= HandState.River);

                        if (dealt)
                        {
                            <span class="card"><img class="card-img" src="images/cards/@(GameState.GetCommunityCards()[i]).svg" /></span>
                        }
                        else
                        {
                            <div class="card card-placeholder"></div>
                        }
                    }
                }
            </div>

            <div class="action-bar">
                <button class="btn-action" @onclick="ToggleQrCode">@(ShowQrCode ? "Hide QR code" : "Show QR code")</button>

                <button class="btn-action" disabled="@(GameState.HandState == HandState.River)" @onclick="GameState.AdvanceHandState">@AdvanceButtonText</button>

                <button class="btn-action" @onclick="GameState.RedealGame">Next hand</button>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private GameState? GameState => GameStateManager.GetOrCreateGameState(GameId);

    private Player? LocalPlayer;

    private bool ShowQrCode = true;

    private string AdvanceButtonText => GameState?.HandState switch
    {
        HandState.Preflop => "Deal flop",
        HandState.Flop => "Deal turn",
        HandState.Turn => "Deal river",
        _ => "Deal river",
    };

    private string JoinQrCodeDataUri => GenerateQrCodeDataUri(NavigationManager.Uri);

    private void ToggleQrCode() => ShowQrCode = !ShowQrCode;

    private static string GenerateQrCodeDataUri(string url)
    {
        using var qrGenerator = new QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(url, QRCodeGenerator.ECCLevel.Q);
        var qrCode = new PngByteQRCode(qrCodeData);
        var qrCodeBytes = qrCode.GetGraphic(20);
        return $"data:image/png;base64,{Convert.ToBase64String(qrCodeBytes)}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var localPlayerId = await GetOrCreateLocalPlayerId();

        LocalPlayer = GameState.AddOrFindPlayer(localPlayerId);
        LocalPlayer.IsOnline = true;
        GameState.OnGameStateChanged += HandleGameStateChanged;
        StateHasChanged();
    }

    public void Dispose()
    {
        if (LocalPlayer is not null)
        {
            LocalPlayer.IsOnline = false;
        }

        GameState.OnGameStateChanged -= HandleGameStateChanged;

        if (GameState.PlayerCount == 0)
        {
            GameStateManager.RemoveGameState(GameId);
        }
    }

    private void HandleGameStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task<Guid> GetOrCreateLocalPlayerId()
    {
        var localPlayerIdResult = await ProtectedLocalStore.GetAsync<Guid>("LocalPlayerId");
        if (localPlayerIdResult.Success && localPlayerIdResult.Value != Guid.Empty)
        {
            return localPlayerIdResult.Value;
        }

        var newPlayerId = Guid.NewGuid();
        await ProtectedLocalStore.SetAsync("LocalPlayerId", newPlayerId);
        return newPlayerId;
    }
}
